@model Filminurk.Models.FavouriteLists.FavouriteListUserDetailsViewModel

@{
	int rowNumber = 1;
	ViewData["Title"] = "Favourite List Details";
}

<div>
	@if (Model.IsReported == true)
	{
		@: Sinu nimekiri on perses
		@: Oleme seadnud nimekirja privaatseks, kuni admin selle üle vaatab. <br/>
	}
	<table>
		<tr>@Model.ListName</tr>
		 <tr>
@* 			<partial name="_ImageIndex" model="@Model.Image" /> *@
		</tr> 
	</table>
</div>

<div>
	<form>
		<table class="table">
		@foreach (var movie in Model.ListOfMovies)
		{
			<tr>
				<table class="table" style="border:thick">
					<tr>
						<td colspan="2">@movie.Title</td>
					</tr>

					<tr>
						<td>(IMAGE HERE)</td>
						<td>
							<table>
								<tr>@movie.Description</tr>
								<tr>@movie.Director</tr>
								<tr>@movie.DeadCounter</tr>
								<tr>@movie.CurrentRating</tr>
								<tr>@movie.AliveCounter</tr>
							</table>
						</td>
					</tr>
				</table>
			</tr>
		}
	</table>
	<div>
			<form asp-action="UserTogglePrivacy" asp-controller="FavouriteLists" method="post" class="d-inline">
				<input type="hidden" name="id" value="@Model.FavouriteListID" />
				<button type="submit" class="btn btn-warning">Muuda nimekiri privaatseks</button>
			</form>

			<form asp-action="UserDelete" asp-controller="FavouriteLists" method="post" class="d-inline">
				<input type="hidden" name="id" value="@Model.FavouriteListID" />
				<button type="submit" class="btn btn-danger">Kustuta nimekirja</button>
			</form>

			<a asp-action="UserEditList" asp-controller="FavouriteLists"
			   asp-route-id="@Model.FavouriteListID" class="btn btn-success">Muuda nimekirja sisu ja andmeid</a>

			<a asp-action="Index" asp-controller="FavouriteLists" class="btn btn-light">Tagasi</a>
	</div>
		</form>
</div>