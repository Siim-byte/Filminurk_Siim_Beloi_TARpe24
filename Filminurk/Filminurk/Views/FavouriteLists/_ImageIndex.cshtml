@model Filminurk.Models.FavouriteLists.FavouriteListIndexImageViewModel

@if (Model == null || Model.ImageData == null || Model.ImageData.Length == 0)
{
    <img width="128" src="~/lib/defaultassets/image/noposter.png" />
}
else
{
    <img class="card-img-top" src="@Model.Image" alt="@Model.ImageTitle" />
}

